# Maintainer: Nicolai Dagestad <nicolai@dagestad.fr>

pkgname="fuddly-git"
conflicts=("${pkgname/-git/}")
provides=("${pkgname/-git/}")
replaces=("python-$pkgname" "python-${pkgname/-git/}")
pkgver=0.30.r905.0dbf64a
pkgrel=1
pkgdesc="Fuzzing and Data Manipulation Framework (for GNU/Linux)"
arch=('any')
url="https://github.com/k0retux/fuddly"
license=('GPL-3.0-or-later')

depends=(
	"python"
	"python-crcmod"
	"python-graphviz"
	"python-matplotlib"
	"python-paramiko"
	"python-pyserial"
	"python-pyxdg"
	"python-rpyc"
	"python-sphinx_rtd_theme"
	"python-argcomplete"

	# For tests
	"python-ddt"

	# Aur
	"python-constraint"
	"python-configparser"
	"python-xtermcolor"
	## For tests
	"python-mock"
)

makedepends=(
	"git"
	"python-setuptools"
	"python-build"
	"python-installer"
	"scdoc"
)
options=(!emptydirs)
source=("$pkgname::git+$url")
sha256sums=('SKIP')

pkgver() {
	cd "$srcdir/${pkgname}"
	# Tags only exist on master so this just doesn't work for now...
	# printf "%s" "$(git describe --long --tags | sed 's/\([^-]*-\)g/r\1/;s/-/./g')"
	revision=$(git log --oneline | wc -l)
	commit_hash=$(git log --oneline -n1 | cut -d' ' -f1)
	printf "0.30.r%s.%s" "$revision" "$commit_hash"
}

build() {
	cd "${srcdir}/${pkgname}"
	python -m build --wheel --no-isolation
	cd docs
	scdoc < fuddly.1.scd | gzip > fuddly.1.gz
}

package() {
	cd "${srcdir}/${pkgname}"
	python -m installer --no-compile-bytecode --destdir="${pkgdir}" dist/*.whl
	install -Dm644 contrib/shell_completions/zsh/_fuddly -t "${pkgdir}/usr/share/zsh/site-functions/"
	install -Dm644 contrib/shell_completions/fish/fuddly.fish -t "${pkgdir}/usr/share/fish/vendor_completions.d/"
	install -Dm644 contrib/shell_completions/bash/fuddly -t "${pkgdir}/usr/share/bash-completion/completions/"
	install -Dm644 docs/fuddly.1.gz -t "${pkgdir}/usr/share/man/man1/"
}
